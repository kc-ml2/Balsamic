#!/usr/bin/env bash
# A local Balsamic stack for trying the workspace: the implementation service, a Pi harness (the scripted fake by
# default, the real one with --real), and the workspace serving the built frontend. No Tailnet, nothing shared.
#   scripts/dev-stack up [--real] [--dir runs/dev]    start (idempotent); then open http://127.0.0.1:8765
#   scripts/dev-stack down                            stop what it started
#   scripts/dev-stack status                          show ports and pids
# MEENT is the meent-private fork that scripts/install-meent installs. Runs compute on one GPU slot when PyTorch sees a CUDA
# device and on CPU slots beside it: one per physical core, less one kept for the system and the services, and less the GPU
# slot, whose worker keeps a core busy. BALSAMIC_WORKERS (all slots) and BALSAMIC_GPU_WORKERS (0 for CPU only) choose.
set -euo pipefail
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="${1:-status}"; shift || true
dir="$repo/runs/dev"; real=0
while [ $# -gt 0 ]; do case "$1" in --real) real=1;; --dir) dir="$2"; shift;; *) echo "unknown option $1" >&2; exit 2;; esac; shift; done
mkdir -p "$dir"
pids="$dir/pids"; token="$dir/pi.token"
WORKSPACE_PORT="${BALSAMIC_PORT:-8765}"; LIBRARY_PORT="${BALSAMIC_LIBRARY_PORT:-8767}"; PI_PORT="${BALSAMIC_PI_PORT:-8768}"

alive() { [ -f "$pids" ] && while read -r name pid; do kill -0 "$pid" 2>/dev/null && echo "$name $pid"; done < "$pids"; }
start() {
  local name="$1"; shift
  if alive | grep -q "^$name "; then echo "$name already running"; return; fi
  # Fully detached: no inherited pipe keeps the caller waiting.
  ( cd "$repo" && setsid nohup "$@" < /dev/null > "$dir/$name.log" 2>&1 & echo "$name $!" >> "$pids" )
  echo "$name started (log: $dir/$name.log)"
}
case "$cmd" in
  up)
    [ -f "$token" ] || python3 -c "import secrets,sys; open(sys.argv[1],'w').write(secrets.token_hex(24))" "$token"
    [ -f "$repo/frontend/dist/index.html" ] || (cd "$repo/frontend" && npm ci && npm run build)
    start library uv run optimization-implementations --directory "$dir/library" --port "$LIBRARY_PORT"
    profile="${GRATING_PI_PROFILE:-$repo/agent-harness/profiles/dev}"
    secrets="${BALSAMIC_SECRETS:-$HOME/.config/balsamic/secrets.env}"
    if [ "$real" = 1 ]; then
      [ -d "$repo/agent-harness/dist" ] || (cd "$repo/agent-harness" && npm ci && npm run build)
      # Provider keys (KEY=value lines) reach the harness only; the dev profile names the default model.
      secret_env=(); if [ -f "$secrets" ]; then while IFS= read -r line; do case "$line" in ''|'#'*) ;; *) secret_env+=("$line");; esac; done < "$secrets"; fi
      start pi env "${secret_env[@]}" GRATING_PI_TOKEN_FILE="$token" GRATING_PI_DIRECTORY="$dir/pi" GRATING_PI_PORT="$PI_PORT" \
        GRATING_PI_WORKSPACE_URL="http://127.0.0.1:$WORKSPACE_PORT" GRATING_PI_PROFILE="$profile" \
        node "$repo/agent-harness/dist/server.js"
      mode_env=(GRATING_PI_PROFILE="$profile")
    else
      mode_env=(GRATING_PI_PROVIDER=openai-codex)
      start pi env GRATING_PI_TOKEN_FILE="$token" GRATING_PI_WORKSPACE_URL="http://127.0.0.1:$WORKSPACE_PORT" \
        uv run python "$repo/tests/fake_harness.py" --port "$PI_PORT"
    fi
    cores="$(lscpu -p=Core,Socket 2> /dev/null | grep -v '^#' | sort -u | wc -l)"; [ "$cores" -gt 0 ] || cores="$(nproc)"
    gpu="${BALSAMIC_GPU_WORKERS:-}"
    [ -n "$gpu" ] || gpu="$("$repo/.venv/bin/python" -c 'import torch; print(1 if torch.cuda.is_available() else 0)' 2> /dev/null || echo 0)"
    workers="${BALSAMIC_WORKERS:-$(( cores > 2 ? cores - 1 : 2 ))}"; [ "$workers" -le 16 ] || workers=16
    # A runtime profile answers for these settings only, as with scripts/labctl.
    settings="{\"cuda_mps\": null, \"gpu_workers\": $gpu, \"workers\": $workers}"
    start workspace env -u GRATING_DEVICE "${mode_env[@]}" GRATING_RESOURCE_SETTINGS="$settings" GRATING_PI_TOKEN_FILE="$token" GRATING_PI_URL="http://127.0.0.1:$PI_PORT" \
      GRATING_LLM_ENABLED=true GRATING_LLM_DISABLED=false GRATING_IMPLEMENTATION_URL="http://127.0.0.1:$LIBRARY_PORT" \
      uv run optimization-lab --directory "$dir/workspace" --port "$WORKSPACE_PORT" --workers "$workers" --gpu-workers "$gpu"
    for i in $(seq 1 30); do curl -sf "http://127.0.0.1:$WORKSPACE_PORT/api/health" > /dev/null && break; sleep 1; done
    echo "workspace: http://127.0.0.1:$WORKSPACE_PORT   (harness: $([ "$real" = 1 ] && echo real || echo fake) on $PI_PORT; library on $LIBRARY_PORT)"
    echo "workers: $workers at once, $gpu on the GPU and $(( workers - gpu )) on CPU ($cores physical cores)"
    echo "frontend dev server with hot reload instead: cd frontend && npm run dev   (http://127.0.0.1:5173)";;
  down)
    # Each service is its own session (setsid): stop the whole group, then whatever still holds the ports.
    if [ -f "$pids" ]; then while read -r name pid; do { kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null; } && echo "stopped $name" || true; done < "$pids"; rm -f "$pids"; fi
    sleep 1; fuser -k "$WORKSPACE_PORT/tcp" "$LIBRARY_PORT/tcp" "$PI_PORT/tcp" > /dev/null 2>&1 || true;;
  status) alive || echo "nothing running from $pids";;
  *) echo "usage: scripts/dev-stack up [--real] [--dir DIR] | down | status" >&2; exit 2;;
esac
