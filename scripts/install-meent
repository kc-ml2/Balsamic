#!/usr/bin/env bash
# Install what the MEENT problems run on: the meent-private fork (feature/cuda-acceleration) as the project's meent, with
# PyTorch, and mask-optimizers for the mask methods. The fork is Torch-only: the 1D solver runs it on CPU, the 2D solver on
# CUDA when scripts/start finds a device. pyproject.toml names the fork; uv.lock pins its commit.
#   scripts/install-meent             install the locked commit; then restart (scripts/stop --keep-tailnet && scripts/start)
#   scripts/install-meent --update    move the lock to the branch tip first
# The lab checks that an evaluator starts before it queues any run on it, so a missing piece shows up there, not in a probe.
set -euo pipefail
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"
case "${1:-}" in
  --update) uv lock --upgrade-package meent;;
  "") ;;
  *) echo "usage: scripts/install-meent [--update]" >&2; exit 2;;
esac
# --inexact keeps the extras installed for other work (dev).
uv sync --inexact --extra meent --extra learners --extra masks

# Build both evaluators as a worker would, the 2D one on each device.
for device in cpu cuda; do
  GRATING_DEVICE="$device" uv run --no-sync python - <<'PY'
import os
from dqn_meent.problem import MeentProblem
from dqn_meent.problem_2d import Meent2DProblem
device = os.environ["GRATING_DEVICE"]
for adapter in ((MeentProblem(),) if device == "cpu" else ()) + (Meent2DProblem(),):
    example = adapter.examples()[0]["instances"][0]
    name = "2D" if isinstance(adapter, Meent2DProblem) else "1D"
    try:
        adapter.evaluator(adapter.resolve(example["configuration"], example.get("fidelity") or {}))
        from dqn_meent.rcwa import source
        print(f"{name} MEENT solver on {'cpu' if name == '1D' else device}: starts, {source()}")
    except Exception as error:
        print(f"{name} MEENT solver on {device}: cannot start: {error}")
PY
done
